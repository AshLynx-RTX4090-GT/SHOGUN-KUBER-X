# For local development SQLite needs no separate database service.
DATABASE_URL="sqlite:///./payment.db"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_test_key_secret"
# Configure the same value in Razorpay Dashboard > Webhooks.
RAZORPAY_WEBHOOK_SECRET="replace-with-a-separate-long-random-secret"
FRONTEND_ORIGINS="http://localhost:3000,http://localhost:5173"

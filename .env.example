# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT Secret for secure user authentication & RBAC session signing
JWT_SECRET="shogun-kuber-x-secure-jwt-secret-2026"

# Optional AWS S3 Configuration (AWS SDK v3)
# If provided, connects to real AWS S3 buckets; otherwise uses high-speed persistent engine
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME="kuber-x-media-assets-prod"
# Optional display/audit metadata for the in-app AWS account panel (12-digit account ID).
AWS_ACCOUNT_ID=""
# Optional AWS Backup plan and EBS volume IDs. EBS snapshots protect EC2 volumes;
# S3 file rollback is provided by the S3 Versioning action in the app.
AWS_BACKUP_PLAN_ARN=""
AWS_EBS_SNAPSHOT_VOLUMES=""

# Optional. Used only on the server for country-level reverse geocoding; never expose in VITE_ variables.
# Enable the Geocoding API for this key in Google Cloud.
GOOGLE_MAPS_API_KEY=""

# Browser key restricted to Maps Embed API and the app's allowed origins.
VITE_GOOGLE_MAPS_API_KEY=""

# PostgreSQL connection string. Local development can use the Docker Compose database.
DATABASE_URL="postgresql://shogun:change-me@localhost:5432/shogun_kuber_x"

# Base64 uploads are accepted by the application server up to this size. For larger 4K/HD media,
# deploy a multipart presigned-upload service behind the same IAM policy.
MAX_UPLOAD_BYTES="52428800"

# Razorpay Standard Checkout. Use rzp_test_* keys for test transactions; only rzp_live_*
# keys from your activated Razorpay account can collect real UPI/card payments.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Browser-to-Python payment service URL. Leave at localhost for development.
VITE_PAYMENT_API_URL="http://localhost:8000"
